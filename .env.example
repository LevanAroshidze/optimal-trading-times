# Copy this file to .env and fill in real values. Never commit your .env file.

# Required: Discord webhook URL for the announcement channel.
# Format: https://discord.com/api/webhooks/<id>/<token>
DISCORD_WEBHOOK_URL=

# Optional: Discord webhook URL for operational alerts (calendar source failures,
# weekly no-data skips, and state-lock risk). If unset, alerts are logs only.
DISCORD_OPS_WEBHOOK_URL=
